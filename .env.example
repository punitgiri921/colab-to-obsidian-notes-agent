# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional: Vision Deployment (defaults to AZURE_OPENAI_DEPLOYMENT if omitted)
# AZURE_OPENAI_VISION_DEPLOYMENT=gpt4-1-mini
# AZURE_OPENAI_VISION_API_VERSION=2025-04-14

# Optional: Reasoning effort and token budget
AZURE_OPENAI_REASONING_EFFORT=high
AZURE_OPENAI_MAX_COMPLETION_TOKENS=32768
